<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Register for upcoming Coding Club events and workshops">
    <meta name="keywords" content="Registration, Form, Events, Schedule">
    <meta name="author" content="Coding Club Team">
    <title>Coding Club - Events & Registration</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico">
</head>
<body>

    <!-- Shared Navigation Menu -->
  

    <hr>

    <main>
        <h1>Upcoming Club Events</h1>

        <!-- 4.3 Events Table -->
        <table border="1">
            <caption>Semester Event Schedule</caption>
            <thead>
                <tr>
                    <th>Event ID</th>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Location</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>EVT-01</td>
                    <td>Web Dev Basics Workshop</td>
                    <td>Nov 10, 2026</td>
                    <td>Lab 301</td>
                </tr>
                <tr>
                    <td>EVT-02</td>
                    <td>24-Hour Code Jam</td>
                    <td>Nov 22, 2026</td>
                    <td>Student Hub</td>
                </tr>
                <tr>
                    <td>EVT-03</td>
                    <td>Intro to Python & AI</td>
                    <td>Dec 05, 2026</td>
                    <td>Auditorium B</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4">Total Upcoming Events: 3</td>
                </tr>
            </tfoot>
        </table>

        <br><hr><br>

        <h2>Event Registration Form</h2>

        <!-- 4.1 & 4.2 Registration Form -->
        <form action="#" method="post">

            <!-- 4.1 Name, Email, Password -->
            <div>
                <label for="fullname">Full Name:</label><br>
                <input type="text" id="fullname" name="fullname" required>
            </div>
            <br>

            <div>
                <label for="email">Email Address:</label><br>
                <input type="email" id="email" name="email" required>
            </div>
            <br>

            <div>
                <label for="password">Account Password:</label><br>
                <input type="password" id="password" name="password" required>
            </div>
            <br>

            <!-- 4.2 Date & Phone -->
            <div>
                <label for="dob">Date of Birth:</label><br>
                <input type="date" id="dob" name="dob">
            </div>
            <br>

            <div>
                <label for="phone">Phone Number:</label><br>
                <input type="tel" id="phone" name="phone">
            </div>
            <br>

            <!-- Radio Buttons -->
            <div>
                <label>Year of Study:</label><br>
                <input type="radio" id="year1" name="year" value="1st Year">
                <label for="year1">1st Year</label>
                <input type="radio" id="year2" name="year" value="2nd Year">
                <label for="year2">2nd Year</label>
                <input type="radio" id="year3" name="year" value="3rd Year">
                <label for="year3">3rd Year</label>
                <input type="radio" id="year4" name="year" value="4th Year">
                <label for="year4">4th Year</label>
            </div>
            <br>

            <!-- Dropdown / Select -->
            <div>
                <label for="event-select">Select Event to Attend:</label><br>
                <select id="event-select" name="event_choice">
                    <option value="">-- Choose an event --</option>
                    <option value="evt-01">Web Dev Basics Workshop</option>
                    <option value="evt-02">24-Hour Code Jam</option>
                    <option value="evt-03">Intro to Python & AI</option>
                </select>
            </div>
            <br>

            <!-- Checkboxes -->
            <div>
                <label>Topics of Interest:</label><br>
                <input type="checkbox" id="topic1" name="interests" value="HTML/CSS">
                <label for="topic1">HTML / CSS</label><br>
                <input type="checkbox" id="topic2" name="interests" value="JavaScript">
                <label for="topic2">JavaScript</label><br>
                <input type="checkbox" id="topic3" name="interests" value="Python">
                <label for="topic3">Python</label>
            </div>
            <br>

            <!-- Textarea -->
            <div>
                <label for="message">Additional Message / Dietary Restrictions:</label><br>
                <textarea id="message" name="message" rows="4" cols="40" placeholder="Type here..."></textarea>
            </div>
            <br>

            <!-- Submit Button -->
            <div>
                <input type="submit" value="Register Now">
            </div>

        </form>
    </main>

    <hr>
    <footer>
        <p>&copy; 2026 Campus Coding Club. All rights reserved.</p>
    </footer>

</body>
</html>
